        builtins.print(f"DBG choose t={t:.2f} pick={chosen} why={reason} f={fhs} s={shs} obj_min={pick['min_gap_obj']:.2f} rob={pick['robust_min_gap_obj']:.2f} map={pick['min_gap_map']:.2f}")
    return pick["v"], pick["w"], info
'''


def build(source):
    replacements = {"_base_command_candidates": CANDIDATES, "_base_choose_rank": RANK, "choose_command": CHOOSE}
    nodes = {n.name: n for n in ast.parse(source).body if isinstance(n, ast.FunctionDef)}
    lines = source.splitlines(keepends=True)
    for name in sorted(replacements, key=lambda key: nodes[key].lineno, reverse=True):
        node = nodes[name]
        lines[node.lineno - 1:node.end_lineno] = [replacements[name].rstrip() + "\n"]
    out = "".join(lines)
    out = out.replace("def _base_command_candidates(", "_BASE_ESCAPE_CONFIG = " + repr(ESCAPE_CONFIG) + "\n\n\ndef _base_command_candidates(", 1)
    compile(out, "<B-5-16 base v5>", "exec")
    return out


if __name__ == "__main__":
    source = build(SRC.read_text())
    archive_before_write(OUT)
    OUT.write_text(source)
    print(f"{OUT.name} sha16={hashlib.sha256(source.encode()).hexdigest()[:16]} chars={len(source)}")
