CHANGES = (
    "v16 path shape/count/issues and repair hints expose one-point simplification failures without changing acceptance.",
    "plan_stage records model-supplied grid/search/simplify/validate progress; no search or simplification algorithm is supplied.",
    "Preserve the first point, compare before/after point counts, and permit validated raw paths rather than forcing simplification.",
    "Retain B527 cached-grid performance guidance, edge checks, retry policy, scene sentence and explicit200s tool argument.",
)
SHORTENINGS = CHANGES
replace_once = PREV.replace_once


def build(src, base=None):
    assert hashlib.sha256(src.encode()).hexdigest()[:16] == SRC_SHA16
    base = BASE.read_text() if base is None else base
    assert BASE_SHA16 is not None and hashlib.sha256(base.encode()).hexdigest()[:16] == BASE_SHA16
    text = replace_once(src, src.splitlines()[0], TITLE)
    text = replace_once(text, "- 단순화에서는 기준점(anchor)", SHAPE_DOC + "\n- 단순화에서는 기준점(anchor)")
    text = replace_once(text,
        "`validate_plan`의 거부 정보를 버리고 None만 반환하면 base에는 빈 경로라는 사실만 보입니다.",
        "`validate_plan`의 거부 정보를 버리고 None만 반환하면 base는 빈 경로와 마지막으로 남긴 단계 표시만 알 수 있습니다.")
    text = replace_once(text,
        "- 먼저 `plan_summary`의 채택 결과를 확인합니다. `no_path`이면 `plan_path`의 불량 연결을 고치고,",
        "- 먼저 `plan_summary`의 채택 결과와 `plan_reject`의 형태·점 수·단계·수리 힌트를 확인합니다. `no_path`이면 `plan_path`의 반환 형태 또는 불량 연결을 고치고,")
    assert text.count(SCENE_SENTENCE) == 1
    return text


def archive_write(path, text):
    if path.exists():
        if path.read_text() == text:
            return
        shutil.copy2(path, ARENA / "results" / f"archive_{path.name}_before_b528_{datetime.now():%Y%m%d_%H%M%S_%f}")
    path.write_text(text)


if __name__ == "__main__":
    archive_write(OUT, build(SRC.read_text()))
    print("wrote", OUT, "chars", len(OUT.read_text()))
