def build(src, base=None):
    base = BASE.read_text() if base is None else base
    assert hashlib.sha256(base.encode()).hexdigest()[:16] == BASE_SHA16, "B-5-20 must reuse the exact v8 base"
    src = replace_once(src, src.splitlines()[0], TITLE)
    src = replace_once(src, "다음 여섯 가지를 지켜 구현하십시오", "다음 규칙을 지켜 구현하십시오")
    src = replace_once(src,
        "답은 ```python 으로 여는 코드 블록 하나에 담고, 블록 안에는 코드만 넣으십시오. 블록 밖의 설명은 채점에 쓰지 않습니다.",
        "최종 답은 ```python 으로 여는 코드 펜스 하나에 수정 블록만 담으십시오. JSON 문자열이나 설명문으로 내지 말고,\n"
        "펜스 밖 설명도 넣지 않습니다. 시험 도구의 JSON 인자 형식은 그대로이며, 아래 '제출' 절에 올바른/잘못된 최종 답 예시가 있습니다.")
    src = replace_once(src,
        "- 움직이는 물체에 대한 판단은 base 의 `choose_command(v, w, target_xy)` 가 합니다. 매 제어 주기마다 아래 추종 방법으로",
        "- 움직이는 물체에 대한 판단은 base 의 `choose_command(v, w, target_xy)` 가 합니다. 매 제어 주기에 정확히 한 번만 부릅니다.\n"
        "  아래 추종 방법으로")
    src = replace_once(src, PREV.INPUT_DOC, INPUT_DOC)
    src = replace_once(src, PREV.PATH_DOC, PATH_DOC)
    src = replace_once(src, "최초 계획의 `START` 또는 재계획의 현재 위치와 마지막 `GOAL` 을 보존하고", "각 계획의 실제 현재 위치와 마지막 `GOAL` 을 보존하고")
    src = replace_once(src, PLAN_FAILURE_OLD, PLAN_FAILURE_DOC)
    src = replace_once(src, PREV.REPLAN_DOC, REPLAN_DOC)
    src = replace_once(src,
        "아래 식은 `choose_command()` 에 넘길 추종 명령을 계산하는 방법입니다. 정렬과 종료를 포함해 실제 반환 명령은\n"
        "항상 `choose_command()` 가 고른 값을 씁니다.\n",
        "아래 식은 `choose_command()` 에 넘길 추종 명령을 계산하는 방법입니다. 정렬과 종료를 포함해 실제 반환 명령은\n"
        "항상 `choose_command()` 가 고른 값을 씁니다.\n\n" + TICK_DOC)
    src = replace_once(src, PREV.GOAL_DOC, GOAL_DOC)
    src = replace_once(src,
        "- 명령 선택 함수 `choose_command(v_follow, w_follow, target_xy, horizon_s=3.0)` 는 매 제어 주기에 부릅니다.",
        "- 명령 선택 함수 `choose_command(v_follow, w_follow, target_xy, horizon_s=3.0)` 는 매 제어 주기에 정확히 한 번 부릅니다.")
    src = replace_once(src,
        "  경로 위에서 계산한 앞쪽 목표점의 (x, y) 를 `target_xy` 로 넘깁니다. 반환은 `(v, w, info)` 이고 반환한 속도를 그대로 씁니다.",
        "  경로 추종에서는 검증한 경로 위 앞쪽 목표점의 (x, y), 목표 정렬·정지와 경로 실패 요청에서는 `GOAL[:2]` 를\n"
        "  `target_xy` 로 넘깁니다. 반환은 `(v, w, info)` 이고 반환한 속도를 그대로 씁니다. 같은 주기에 다시 호출하지 않습니다.")
    src = replace_once(src, PREV.SUBMISSION_DOC, PREV.SUBMISSION_DOC + "\n" + FORMAT_DOC)
    return src


def archive_write(path, text):
    if path.exists():
        if path.read_text() == text:
            return
        shutil.copy2(path, ARENA / "results" / f"archive_{path.name}_before_b520_{datetime.now():%Y%m%d_%H%M%S_%f}")
    path.write_text(text)


if __name__ == "__main__":
    archive_write(OUT, build(SRC.read_text()))
    print("wrote", OUT)
