def sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def masked_hooks(source):
    tree = ast.parse(source)
    for node in tree.body:
        if isinstance(node, ast.FunctionDef) and node.name in HOOKS:
            node.body = [ast.Pass()]
    return ast.dump(tree)


def controller_variant(reference, mode):
    if mode == "wrapper":
        return reference
    tree = ast.parse(reference)
    fn = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "controller")
    fn.body = ast.parse("return 0., 0., False" if mode == "zero" else "raise RuntimeError('EDIT controller must not run')").body
    return BP.SCAFFOLD.split("def plan_path", 1)[0] + ast.unparse(tree) + "\n" + A.SP.END + "\n"


def run_dispatcher(spliced_source, reference):
    """Load actual selected base helpers and actual _robot_only from built code."""
    ns = load_ns(BP.BASE)
    ns.update(heapq=heapq, START=ns["MISSION"]["start_xy_yaw"], GOAL=ns["MISSION"]["goal_xy_yaw"], _BASE_DBG_STATE={"t": 0.})
    tree = ast.parse(spliced_source)
    selected = [n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name in (*HOOKS, "controller", "_robot_only")]
    exec(compile(ast.Module(body=selected, type_ignores=[]), "<actual spliced B527 functions>", "exec"), ns)
    calls, output, details, emitted = [], [], [], []
    ns["builtins"].print = lambda *args, **kwargs: emitted.append(" ".join(str(a) for a in args))
    for name in (*HOOKS, "choose_command", "controller"):
        original = ns[name]
        def record(*args, _name=name, _original=original, **kwargs):
            calls.append(_name)
            return _original(*args, **kwargs)
        ns[name] = record
    # There is no ROS/LiDAR stream in this CPU dispatch test. Keep the original
    # empty observed-object store and the full actual map/chooser implementation.
    ns["_base_track_step"] = lambda t: None
    for t in (0., 1./60.):
        output.append(ns["_robot_only"](t, ns["START"], None))
        details.append(copy.deepcopy(ns["_BASE_LOOP_ST"]["last"]))
    return {"calls": calls, "outputs": output, "phases": [d["phase"] for d in details],
            "nominal": [d["nominal"] for d in details], "choice": [d["info"]["chosen"] for d in details],
            "plan_attempts": [{k:v for k,v in row.items() if k != "plan_ms"} for row in details[0]["plan_attempts"]], "target_corrected": [d["target_corrected"] for d in details],
            "target_requested": [d["target_requested"] for d in details], "target_xy": [d["target_xy"] for d in details],
            "target_reject_reason": [d["target_reject_reason"] for d in details],
            "target_ahead_m": [d["target_ahead_m"] for d in details],
            "target_corrected_ahead_m": [d.get("target_corrected_ahead_m") for d in details],
            "fault_logs": [line for line in emitted if line.startswith("DBG base_loop ")],
            "unchanged_return": all(tuple(d["command"]) == tuple(o[:2]) for d, o in zip(details, output))}


def target_contract_checks():
    import math
    ns = load_ns(BP.BASE)
    ns["WALLS"] = (-100.,100.,-100.,100.)
    ns["_MAP_RECTS"][:] = [ns["np"].array([[50.,51.,50.,51.]])]
    guard = ns["_base_loop_guard_target"]
    straight = [(0., 0.), (5., 0.)]
    checks = []
    for ahead in (.3, 2.):
        target = (1. + ahead, 0.)
        got, detail = guard(straight, (1., 0., 0.), target, 0.)
        checks.append((f"target arc boundary{ahead}m accepted", got == target and detail["target_reject_reason"] is None))
    got, detail = guard(straight, (3.5, 0., 0.), (5., 0.), 0.)
    checks.append(("last-segment GOAL in forward range retained", got == (5., 0.) and detail["target_ahead_m"] == 1.5 and not detail["target_corrected"]))
    got, detail = guard(straight, (1., 0., 0.), (2., 1.), 0.)
    checks.append(("path-distance1m boundary accepted with valid forward arc", got == (2., 1.) and detail["target_reject_reason"] is None))
    got, detail = guard([(0., 0.), (5., 0.), (5., 5.)], (4., 0., 0.), (5., 1.2), 0.)
    checks.append(("target uses path arc rather than shorter Euclidean distance", math.dist((4., 0.), (5., 1.2)) < 2. and detail["target_reject_reason"] == "too_far" and got == (5., 0.)))
    got, detail = guard([(0., 0.), (1., 0.), (1., 2.)], (.9, 0., 0.), (0., 0.), 0.)
    checks.append(("short-segment fallback advances0.3m along following segment", math.dist(got, (1., .2)) < 1e-12 and abs(detail["target_corrected_ahead_m"] - .3) < 1e-12))
    got, detail = guard([(0., 0.), (1., 0.)], (.9, 1., 0.), (1., 0.), 0.)
    checks.append(("insufficient remaining arc requests checked-zero branch", got is None and detail["target_reject_reason"] == "no_forward_range" and detail["target_fallback_unavailable"]))
    logs = []
    ns["builtins"].print = lambda *args, **kwargs: logs.append(" ".join(str(a) for a in args))
    ns["_BASE_LOOP_ST"]["target_note_t"] = {}
    for t in (0., 9.999, 10.):
        guard(straight, (1., 0., 0.), (5., 0.), t)
    guard(straight, (1., 0., 0.), (0., 0.), 10.)
    checks.append(("target correction DBG throttles each reason independently for10s", len(logs) == 3 and sum("reason=too_far" in s for s in logs) == 2 and sum("reason=behind" in s for s in logs) == 1))
    ns["_BASE_LOOP_ST"]["clearance_m"] = .3
    ns["_MAP_RECTS"][:] = [ns["np"].array([[1.35,1.65,.35,.65]])]
    corner = [(0.,0.), (2.,0.), (2.,2.)]
    got, detail = guard(corner, (1.,0.,0.), (2.,1.), 20.)
    checks.append(("in-range corner shortcut is rejected and checked current-segment target used", got==(2.,0.) and detail["target_ahead_m"]==2. and detail["target_reject_reason"]=="unsafe_connector" and not detail["target_connector_clear"] and detail["target_fallback_connector_clear"] and detail["target_connector_clearance_m"]==.3))
    ns["_MAP_RECTS"][:] = [ns["np"].array([[1.35,1.65,-.15,.65]])]
    got, detail = guard(corner, (1.,0.,0.), (2.,1.), 30.)
    checks.append(("blocked fallback yields checked-zero input marker instead of unchecked target", got is None and detail["target_reject_reason"]=="unsafe_fallback" and detail["target_connector_blocked"] and detail["target_fallback_unavailable"] and detail["target_fallback_connector_clear"] is False))
    return checks


def plan_contract_checks(reference):
    """Public API checks with real map geometry, plus isolated empty-path timing."""
    import math
    ns = load_ns(BP.BASE)
    ns.update(heapq=heapq, START=ns["MISSION"]["start_xy_yaw"], GOAL=ns["MISSION"]["goal_xy_yaw"], _BASE_DBG_STATE={"t": 0.})
    exec(reference, ns)
    path = ns["plan_path"](ns["START"][:2], ns["GOAL"][:2], .5)
    state_before, emitted = copy.deepcopy(ns["_BASE_LOOP_ST"]), []
    ns["builtins"].print = lambda *args, **kwargs: emitted.append(" ".join(str(a) for a in args))
    exact = ns["validate_plan"](path)
    checks = [("public validator before first pose uses MISSION start and preserves exact path", exact["accepted"] and exact["start_source"] == "mission_start" and exact["clearance_m"] == .5 and exact["path"] == path and not exact["connected_start"] and not exact["connected_goal"]),
              ("public validate_plan leaves control state and DBG unchanged", ns["_BASE_LOOP_ST"] == state_before and emitted == [])]
    needed = {"accepted", "path", "reason", "start_gap_m", "goal_gap_m", "check_path", "clearance_m", "endpoint_limit_m", "connected_start", "connected_goal", "start_source", "error", "first_bad_segment_points"}
    checks.append(("public validator exposes acceptance and diagnostic schema", needed <= set(exact)))
    rounded = list(path)
    x0, _, y0, _ = ns["WALLS"]
    for index in (0, -1):
        x, y = rounded[index]
        rounded[index] = (x0 + round((x-x0)/.2)*.2, y0 + round((y-y0)/.2)*.2)
    connected = ns["validate_plan"](rounded)
    checks.append(("0.2m grid endpoints are connected and whole path checked", connected["accepted"] and connected["connected_start"] and connected["connected_goal"] and connected["path"][0] == tuple(ns["START"][:2]) and connected["path"][-1] == tuple(ns["GOAL"][:2]) and 0 < connected["start_gap_m"] <= .5 and 0 < connected["goal_gap_m"] <= .5 and connected["check_path"]["first_bad_segment"] is None and connected["check_path"]["margin_m"] == .25))
    repeated = ns["validate_plan"](connected["path"])
    checks.append(("accepted connected path is idempotent on revalidation", repeated["accepted"] and repeated["path"] == connected["path"] and not repeated["connected_start"] and not repeated["connected_goal"]))
    boundary = list(path)
    length = math.dist(path[0], path[1])
    for gap, expected in ((.5, True), (.5001, False)):
        boundary[0] = tuple(path[0][i] + gap*(path[1][i]-path[0][i])/length for i in (0, 1))
        result = ns["validate_plan"](boundary)
        checks.append((f"endpoint distance{gap}m acceptance boundary", result["accepted"] is expected and (expected or result["reason"] == "endpoint_distance")))
    ns["_BASE_POSES"][:] = [(1., ns["START"][0]+.01, ns["START"][1], ns["START"][2])]
    ns["_BASE_LOOP_ST"]["clearance_m"] = .4
    latest = ns["validate_plan"](path)
    checks.append(("outside planner validator uses latest pose and adopted clearance", latest["accepted"] and latest["start_source"] == "latest_pose" and latest["clearance_m"] == .4 and latest["path"][0] == tuple(ns["_BASE_POSES"][-1][1:3])))
    context_start = (ns["START"][0]+.02, ns["START"][1])
    ns["_BASE_LOOP_ST"]["plan_context"] = (context_start, ns["GOAL"][:2], .35)
    context = ns["validate_plan"](path)
    checks.append(("active attempt context takes priority over latest pose and clearance", context["accepted"] and context["start_source"] == "plan_context" and context["clearance_m"] == .35 and context["path"][0] == context_start and abs(context["check_path"]["margin_m"] - .1) < 1e-12))
    ns["_BASE_LOOP_ST"]["plan_context"] = None
    empty = ns["validate_plan"]([])
    checks.append(("empty public validation reports reason without throwing", not empty["accepted"] and empty["path"] is None and empty["reason"] == "empty_path"))
    runtime = load_ns(BP.BASE)
    runtime.update(START=runtime["MISSION"]["start_xy_yaw"], GOAL=runtime["MISSION"]["goal_xy_yaw"], _BASE_DBG_STATE={"t": 0.})
    robot = next(n for n in ast.parse(BP.BASE.read_text()).body if isinstance(n, ast.FunctionDef) and n.name == "_robot_only")
    exec(compile(ast.Module(body=[robot], type_ignores=[]), "<v15 actual dispatcher empty-path fixture>", "exec"), runtime)
    planned, chosen, retry_logs, trace = [], [], [], []
    def no_path(start, goal, clearance):
        planned.append((runtime["_BASE_DBG_STATE"]["t"], clearance))
        return []
    real_choose = runtime["choose_command"]
    def choose(*args):
        value = real_choose(*args)
        chosen.append(value[:2])
        return value
    runtime.update(plan_path=no_path, choose_command=choose, _base_track_step=lambda t: None)
    runtime["builtins"].print = lambda *args, **kwargs: retry_logs.append(" ".join(str(a) for a in args))
    for t in (0., 9.999, 10., 29.999, 30., 69.999, 70., 129.999, 130.):
        command = runtime["_robot_only"](t, runtime["START"], None)
        detail = runtime["_BASE_LOOP_ST"]["last"]
        trace.append({"t": t, "plan_calls_so_far": len(planned), "chooser_calls_so_far": len(chosen), "command": command, "nominal": detail["nominal"], "next_plan_t": detail["next_plan_t"], "returned_unchanged": command[:2] == chosen[-1]})
    checks.append(("initial empty path retries all four margins at10/20/40/60s boundaries", [r["plan_calls_so_far"] for r in trace] == [4, 4, 8, 8, 12, 12, 16, 16, 20] and [r["next_plan_t"] for r in trace] == [10., 10., 30., 30., 70., 70., 130., 130., 190.]))
    checks.append(("empty-path wait still calls actual chooser exactly once and preserves return", [r["chooser_calls_so_far"] for r in trace] == list(range(1,10)) and all(r["nominal"] == (0., 0.) and r["returned_unchanged"] for r in trace)))
    rejected = [line for line in retry_logs if line.startswith("DBG plan_reject ")]
    checks.append(("repeated identical plan rejection emits details only initially", len(rejected) == 1 and all("reason=empty_path" in s and "min_gap=" in s and "margin=" in s for s in rejected)))
    return checks, {"grid_endpoint_validation": connected, "empty_path_retry_fixture": trace, "plan_rejection_logs": rejected,
                    "scope": "Actual map validator and saved dispatcher; empty synthetic observations and constant pose for retry timing, not Isaac replay."}


def feedback_summary_checks(reference):
    """Actual v15 diagnostics -> actual Run.test -> default 240-char/80-line cap.

    The old model planner is executed on the real map; sensor input is empty.
    Run.test's grade/log sources are replaced by this CPU fixture in a temporary
    directory. Network/process entry points are tripwires, not simulator calls.
    """
    source = ARENA / "results/turns/prompt_b5_24/isaac_logs/gpu_gpt_oss_120b_pB524_a1_t2_test01_carter_run.py"
    old_plan = next(n for n in ast.parse(source.read_text()).body if isinstance(n, ast.FunctionDef) and n.name == "plan_path")
    tree = ast.parse(reference)
    tree.body = [copy.deepcopy(old_plan) if isinstance(n, ast.FunctionDef) and n.name == "plan_path" else n for n in tree.body]
    edit = BP.SCAFFOLD.split("def plan_path", 1)[0] + ast.unparse(tree) + "\n" + A.SP.END + "\n"
    full = A.build(edit)
    ns = load_ns(BP.BASE)
    ns.update(START=ns["MISSION"]["start_xy_yaw"], GOAL=ns["MISSION"]["goal_xy_yaw"], _BASE_DBG_STATE={"t": 0.})
    selected = [n for n in ast.parse(full).body if isinstance(n, ast.FunctionDef) and n.name in (*HOOKS, "controller", "_robot_only")]
    exec(compile(ast.Module(body=selected, type_ignores=[]), "<actual B527 dispatch with original a1 planner>", "exec"), ns)
    emitted, calls, summaries, returns = [], [], [], []
    ns["builtins"].print = lambda *args, **kwargs: emitted.append(" ".join(map(str, args)))
    ns["_base_track_step"] = lambda t: None
    for name in (*HOOKS, "choose_command"):
        original = ns[name]
        def record(*args, _name=name, _original=original, **kwargs):
            calls.append(_name)
            return _original(*args, **kwargs)
        ns[name] = record
    for t in (0., 10., 30.):
        result = ns["_robot_only"](t, ns["START"], None)
        detail = ns["_BASE_LOOP_ST"]["last"]
        returns.append({"t": t, "result": result, "nominal": detail["nominal"],
                        "unchanged": tuple(result[:2]) == tuple(detail["command"])})
        summaries.append(copy.deepcopy(detail["plan_summary"]))
    full_summaries = [s for s in emitted if s.startswith("DBG plan_summary ")]
    stdout = "\n".join(emitted + [f"DBG later_fixture index={i}" for i in range(120)]) + "\n"
    fake_result = {"verdict": "fail", "metrics": {"collision_count": 0, "sim_time_s": 201., "final_dist_m": 32.}}
    external_calls, grade_calls = [], []
    def no_external(*args, **kwargs):
        external_calls.append("unexpected network/process call")
        raise AssertionError("CPU tool-feedback fixture must not run external commands")
    def fake_grade(variant):
        grade_calls.append(variant)
        return copy.deepcopy(fake_result)
    with tempfile.TemporaryDirectory(prefix="b527_actual_tool_feedback_") as temp:
        temp = Path(temp)
        iso, results = temp / "isaac_logs", temp / "results"
        iso.mkdir(); results.mkdir()
        with mock.patch.object(A, "HERE", temp), mock.patch.object(A.TL, "ISAAC_LOG_DIR", iso), \
                mock.patch.object(A.TL, "RESULTS", results), mock.patch.object(A.TL, "grade", fake_grade), \
                mock.patch.object(A, "_logs", lambda variant: (stdout, "")), \
                mock.patch.object(A, "traj_sample", lambda variant: []), mock.patch.object(A, "DBG_FULL_CHARS", 0), \
                mock.patch.object(A.urllib.request, "urlopen", no_external), \
                mock.patch.object(A.TL.subprocess, "run", no_external), mock.patch.object(A.TL.subprocess, "Popen", no_external):
            output, rec = A.Run.test(SimpleNamespace(stem="b527_summary_feedback_cpu"), 1, 1,
                                     {"code": edit, "sim_seconds": 200})
            delivered = [line for line in output.get("controller_output", []) if line.startswith("DBG plan_summary ")]
    # Read what the real harness actually returned, not a second implementation
    # of dbg_lines. The expected semantic results come from the real base state.
    first = delivered[0] if delivered else ""
    tokens = first.split(" attempts=", 1)[1].split(" ms=", 1)[0].split(" adopted_clearance=", 1)[0].split("|") if " attempts=" in first else []
    expected_tokens = [f"{row['c']:.2f}:{'accepted' if row['accepted'] else row['reason']}" for row in summaries[0]["attempts"]]
    checks = [
        ("actual historical center-only planner still fails all four unchanged margins", len(summaries)==3 and all(s["status"]=="no_path" and len(s["attempts"])==4 and not any(r["accepted"] for r in s["attempts"]) for s in summaries)),
        ("unaccepted plan never calls target/follow and still preserves one chooser", calls == (["plan_path"]*4+["choose_command"])*3 and all(r["nominal"]==(0.,0.) and r["unchanged"] for r in returns)),
        ("actual Run.test uses200s and unchanged static/splice checks", output.get("static_check")=="ok" and output.get("sim_seconds")==200. and rec.get("static_ok") is True and len(grade_calls)==1),
        ("actual default tool feedback retains no_path and every attempted clearance within240 chars", len(delivered)==3 and "status=no_path" in first and tokens==expected_tokens and len(tokens)==4 and all(len(line)<=240 for line in delivered)),
        ("actual first40 last40 cap retains initial planning summary", len(output["controller_output"])==80 and output.get("controller_output_omitted_lines",0)>0 and delivered[0]==full_summaries[0][:240]),
        ("feedback fixture executes no model/process/network or simulator", external_calls==[] and grade_calls==["b527_summary_feedback_cpu_t1_test01"]),
    ]
    return checks, {"source": str(source.relative_to(ARENA)), "source_sha256": sha(source.read_text()),
                    "method": "Actual original planner and actual _robot_only/base loop, then actual agent_loop.Run.test with only grade/log/trajectory I/O stubbed in a temporary directory; actual dbg_lines cap and feedback assembly retained.",
                    "full_summary_lines": full_summaries, "delivered_summary_lines": delivered,
                    "base_state_summaries": summaries, "expected_attempt_tokens": expected_tokens, "delivered_attempt_tokens": tokens,
                    "controller_output_lines": len(output.get("controller_output", [])), "omitted_lines": output.get("controller_output_omitted_lines", 0),
                    "external_calls": external_calls, "grade_fixture_calls": grade_calls,
                    "limits": ["CPU map/synthetic empty observations and fixed START, not physical or sensor replay.",
                               "All attempts and status fit in delivered prefix; detailed per-attempt JSON may be cut by the unchanged240-character cap.",
                               "The tool-output test supplies representative stdout, not a new Isaac run."]}


def map_tool_checks():
    """Actual map tools; sampled geometry agreement and explicit synthetic ranks."""
    import math
    ns = load_ns(BP.BASE)
    np = ns["np"]
    checks, grids = [], []
    for clearance in (.5, .45, .4, .35, .1):
        blocked, origin, res = ns["occupancy_grid"](clearance, .5)
        exact = np.empty_like(blocked)
        for iy, ix in np.ndindex(blocked.shape):
            xy = ns["xy_of"]((ix, iy), origin, res)
            exact[iy, ix] = ns["map_clearance"](*xy) < max(.25, clearance) - 1e-12
        checks.append((f"occupancy_grid clearance{clearance} agrees with every actual map centre", blocked.dtype == np.bool_ and np.array_equal(blocked, exact) and origin == (ns["WALLS"][0], ns["WALLS"][2]) and res == .5))
        grids.append({"clearance_m": clearance, "shape": blocked.shape, "occupied": int(blocked.sum()), "origin": origin, "resolution": res})
    checks.append(("cell centres round-trip and floor conversion does not clip outside points", all(ns["cell_of"](ns["xy_of"](cell, origin, res), origin, res)==cell for cell in ((0,0),(3,5),(-1,-1))) and ns["cell_of"]((origin[0]-1e-9,origin[1]),origin,res)==(-1,0)))
    a, _, _ = ns["occupancy_grid"](.5,.5)
    original = a.copy()
    a[:] = ~a
    b, _, _ = ns["occupancy_grid"](.5,.5)
    checks.append(("returned grids are independent caller-owned copies", np.array_equal(b,original)))
    segments = [((-9.,-10.8),(-8.,-10.8)), ((0.,0.),(8.,16.5)), ((8.,16.5),(8.,16.5))]
    parity = []
    for c in (.1,.35,.4,.45,.5):
        for p,q in segments:
            checked = ns["check_path"]([p,q],margin_m=max(0.,c-.25))
            expected = checked["first_bad_segment"] is None and checked["min_gap_map"] >= checked["margin_m"]-1e-12
            parity.append(ns["segment_free"](p,q,c) is expected)
    checks.append(("segment_free exactly shares sampled check_path margin semantics", all(parity)))
    state = copy.deepcopy(ns["_BASE_LOOP_ST"])
    logs=[]
    ns["builtins"].print=lambda *args,**kwargs: logs.append(args)
    ns["occupancy_grid"](.4,.5);ns["cell_of"]((0.,0.),origin,res);ns["xy_of"]((0,0),origin,res);ns["segment_free"](*segments[0],.4)
    checks.append(("map tools do not change control state or emit diagnostics", ns["_BASE_LOOP_ST"]==state and logs==[]))
    def item(map_gap, obj_gap, map_hit=.1, obj_hit=.2):
        return {"v":.3,"w":0.,"t_hit":.1,"t_hit_map":map_hit,"t_hit_obj":obj_hit,
                "min_gap_map":map_gap,"robust_min_gap_obj":obj_gap,"end_pose":(1.,0.,0.)}
    candidates={"follow":item(.19,.1),"slow":item(.18,99.),"stop":item(.17,100.)}
    rank=ns["_base_choose_rank"]
    chosen, reason=rank(candidates,(3.,0.))
    checks.append(("all-map-risk emergency prioritizes map gap over remote object gap", chosen=="follow" and reason=="emergency_map_gap"))
    reversed_choice=rank(dict(reversed(list(candidates.items()))),(3.,0.))
    checks.append(("emergency priority is candidate-order invariant", reversed_choice==(chosen,reason)))
    candidates["slow"]["t_hit_map"]=None
    checks.append(("existing map-clear branch still outranks unsafe-map candidates", rank(candidates,(3.,0.))==("slow","map_clearance_object_gap")))
    candidates["follow"]["t_hit"]=None
    checks.append(("existing safe-follow branch remains unchanged", rank(candidates,(3.,0.))==("follow","follow_safe")))
    return checks, {"grids":grids,"segment_comparisons":len(parity),"scope":"Actual map geometry plus synthetic candidate dictionaries for ranking; no physical run or hidden mover data."}


def main():
    checks = []
    def check(name, passed):
        checks.append({"name": name, "pass": bool(passed)})
        print(("PASS " if passed else "FAIL ") + name)
    before = json.loads((ARENA / "results/analysis/b527_harness_before.json").read_text())
    prompt, prior, base, reference = BP.OUT.read_text(), BP.SRC.read_text(), BP.BASE.read_text(), REFERENCE.read_text()
