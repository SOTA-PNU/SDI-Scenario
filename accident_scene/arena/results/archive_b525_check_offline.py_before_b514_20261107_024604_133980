    record('time_rewind_resets_target_debug_and_projection_history',len(legacy_logs(logs))==2
           and len(s['plan_calls'])==2 and ns['_BASE_LOOP_ST']['last']['robot_path_s']==0.,lines=logs)


def plan_contract_checks(record):
