"""Analysis-only motion prediction ablation; no operational base is written.

apply_patch(ns, 'baseline'|'accel'|'curves') mutates only an already loaded CPU namespace.
The accel variant estimates current velocity from available pose history and
predicts acceleration-limited motion; it uses no simulator velocity or mover truth.
Accel preserves candidate generation/ranking/point geometry/uncertainty.
Curves adds two generic forward curves and preserves the predictor and rank.
"""
import ast
import hashlib
import json
import math
import time
from pathlib import Path

import numpy as np

from b514_build_base import archive_before_write
from b515_check_offline import object_fixture, safe_json, seed

ARENA = Path(__file__).resolve().parents[1]
BASE = ARENA / "base_carter_run_ros_map_lidartime_objects_check_v8.py"
OUT = ARENA / "results/analysis/b520_m1_unit.json"
LIMITS = {"step_s": 1.0/60.0, "linear_accel_m_s2": 2.0, "angular_accel_rad_s2": 2.68}


def observed_velocity(ns):
    """Last pose interval, signed translation in its final heading; no hidden state."""
    poses = ns["_BASE_POSES"]
    if len(poses) < 2:
        return 0.0, 0.0
    current = poses[-1]
    previous = next((p for p in reversed(poses[:-1]) if p[0] < current[0]), None)
    if previous is None:
        return 0.0, 0.0
    if not all(math.isfinite(float(q)) for p in (previous, current) for q in p):
        raise ValueError("Acceleration rollout requires finite pose history")
    elapsed = current[0] - previous[0]
    yaw_delta = math.atan2(math.sin(current[3]-previous[3]), math.cos(current[3]-previous[3]))
    linear = ((current[1]-previous[1])*math.cos(current[3]) + (current[2]-previous[2])*math.sin(current[3])) / elapsed
    return linear, yaw_delta / elapsed


def _rollout_function(ns):
    cache = {"context": None, "curves": {}}
    def rollout(v, w, times):
        poses = ns["_BASE_POSES"]
        context = tuple(tuple(p) for p in poses[-2:])
        if context != cache["context"]:
            cache["context"], cache["curves"] = context, {}
            cache["velocity"] = observed_velocity(ns)
        maximum = float(times[-1])
        key = float(v), float(w)
        item = cache["curves"].get(key)
        if item is None or item[0][-1] < maximum:
            _, x0, y0, yaw0 = poses[-1]
            v0, w0 = cache["velocity"]
            rt = np.minimum(np.arange(int(math.ceil(maximum/LIMITS["step_s"]))+1)*LIMITS["step_s"], maximum)
            steps = np.diff(rt)
            vv = v0 + np.clip(v-v0, -LIMITS["linear_accel_m_s2"]*rt, LIMITS["linear_accel_m_s2"]*rt)
            ww = w0 + np.clip(w-w0, -LIMITS["angular_accel_rad_s2"]*rt, LIMITS["angular_accel_rad_s2"]*rt)
            yaw = np.r_[yaw0, yaw0+np.cumsum(ww[1:]*steps)]
            xx = np.r_[x0, x0+np.cumsum(vv[1:]*np.cos(yaw[1:])*steps)]
            yy = np.r_[y0, y0+np.cumsum(vv[1:]*np.sin(yaw[1:])*steps)]
            item = rt, xx, yy, yaw
            cache["curves"][key] = item
        return tuple(np.interp(times, item[0], q) for q in item[1:])
    return rollout


def apply_patch(ns, variant="accel"):
    """Install one isolated predictor ablation; return auditable patch metadata."""
    if variant not in ("baseline", "accel", "curves"):
        raise ValueError("Unknown M1 analysis variant: " + str(variant))
    if "_M1_PATCH" in ns:
        if ns["_M1_PATCH"]["variant"] != variant:
            raise ValueError("Use a fresh namespace for a different variant")
        return ns["_M1_PATCH"]
    source = BASE.read_text()
    metadata = {"variant": variant, "operational_base_written": False,
                "base_sha16": hashlib.sha256(source.encode()).hexdigest()[:16],
                "limits": dict(LIMITS), "velocity_source": "last available pose-history interval"}
    if variant == "accel":
        if "_base_check_motion" not in ns:
            raise ValueError("Acceleration ablation requires the v8 private motion core")
        tree = ast.parse(source)
        node = next(n for n in tree.body if isinstance(n, ast.FunctionDef) and n.name == "_base_check_motion")
        function = ast.get_source_segment(source, node)
        old = '''    half_turn = 0.5 * w * tt
    travel = v * tt * np.sinc(half_turn / math.pi)
    xx, yy = x0 + travel * np.cos(yaw0 + half_turn), y0 + travel * np.sin(yaw0 + half_turn)
    yaw = yaw0 + w * tt'''
        assert function.count(old) == 1
        function = function.replace(old, "    xx, yy, yaw = _m1_accel_rollout(v, w, tt)", 1)
        old_map = '''        map_half_turn = 0.5 * w * map_tt
        map_travel = v * map_tt * np.sinc(map_half_turn / math.pi)
        map_xx = x0 + map_travel * np.cos(yaw0 + map_half_turn)
        map_yy = y0 + map_travel * np.sin(yaw0 + map_half_turn)
        map_yaw = yaw0 + w * map_tt'''
        assert function.count(old_map) == 1
        function = function.replace(old_map, "        map_xx, map_yy, map_yaw = _m1_accel_rollout(v, w, map_tt)", 1)
        ns["_m1_accel_rollout"] = _rollout_function(ns)
        exec(compile(function, "<analysis-only M1 acceleration core>", "exec"), ns)
        metadata["patched_function_sha16"] = hashlib.sha256(function.encode()).hexdigest()[:16]
    if variant == "curves":
        original_factory = ns["_base_command_candidates"]
        def with_curves(v_follow, w_follow, target_xy=None):
            candidates = original_factory(v_follow, w_follow, target_xy)
            present = {(float(v), float(w)) for _, v, w in candidates}
            for name, v, w in (("curve_l", .3, .4), ("curve_r", .3, -.4)):
                if (v, w) not in present:
                    candidates.append((name, v, w))
                    present.add((v, w))
            return candidates
        ns["_base_command_candidates"] = with_curves
        metadata["added_candidates"] = [("curve_l", .3, .4), ("curve_r", .3, -.4)]
        metadata["rank_changed"] = False
    ns["_M1_PATCH"] = metadata
    return metadata


def selftest():
    from b519_check_offline import space
    checks, evidence = {}, {}
    def check(name, ok, **details): checks[name] = {"pass": bool(ok), **details}
    unchanged_sha = hashlib.sha256(BASE.read_bytes()).hexdigest()

    # Rear sweep: this point starts0.33m away but the actual long rear rotates into it.
    obj = {"x": 0., "y": -.58, "vx": 0., "vy": 0., "vel_ok": True, "points": [[0., -.58]]}
    ns = space([obj])
    now = ns["check_motion"](0., .4, 0.)
    full = ns["check_motion"](0., .4, 3.)
    ns["_BASE_BODY_BOX"] = (-.13, .13, -.25, .25)
    artificially_short_rear = ns["check_motion"](0., .4, 3.)
    check("v8_rear_sweep_is_already_included", abs(now["min_gap_obj"]-.33) < 1e-12 and full["t_hit_obj"] is not None
          and full["min_gap_obj"] < 0. and artificially_short_rear["t_hit_obj"] is None,
          initial=now, full_body=full, diagnostic_short_rear=artificially_short_rear)

    ns = space([{"x": 2., "y": 0., "vx": -.5, "vy": 0., "vel_ok": True, "seen_t": 9.6, "points": [[2., 0.]]}])
    aged = ns["check_motion"](0., 0., 0.)
    ns["_BASE_OBJ_ST"]["tracks"][0]["hist"][-1] = (10., 2., 0.)
    fresh = ns["check_motion"](0., 0., 0.)
    check("seen_t_age_compensated_before_prediction", abs(aged["min_gap_obj"]-1.67) < 1e-12
          and abs(fresh["min_gap_obj"]-aged["min_gap_obj"]-.2) < 1e-12, aged=aged, fresh=fresh)
    ns = space([{"x": 2., "y": 0., "vx": .5, "vy": 0., "vel_ok": True, "seen_t": 9.6, "points": [[2., 0.]]}])
    moving = ns["check_motion"](0., 0., 1.)
    check("dynamic_uncertainty_uses_speed_age_and_future", abs(moving["end_gap_obj"]-moving["robust_end_gap_obj"]-.85) < 1e-12, result=moving,
          expected_extra_m=.15+.5*(.4+1.))
    ns = space([{"x": 2., "y": 0., "vx": .5, "vy": 0., "vel_ok": False, "seen_t": 9.6, "points": [[2., 0.]]}])
    unknown = ns["check_motion"](0., 0., 1.)
    check("unknown_velocity_gets_fixed_margin_and_no_false_motion", abs(unknown["min_gap_obj"]-1.87) < 1e-12
          and abs(unknown["min_gap_obj"]-unknown["robust_min_gap_obj"]-.15) < 1e-12, result=unknown)
    outline = (-.59, .13, -.25, .25)
    chassis, wheel = (-.59, .13, -.18, .18), (-.14, .14, -.25, .25)
    contains = lambda outer, inner: outer[0] <= inner[0] and outer[1] >= inner[1] and outer[2] <= inner[2] and outer[3] >= inner[3]
    check("footprint_comparison_records_one_centimetre_wheel_tip_difference", contains(outline, chassis)
          and not contains(outline, wheel) and abs(wheel[1]-outline[1]-.01) < 1e-12,
          checked_outline=outline, cpu_collision_chassis=chassis, cpu_collision_wheel=wheel,
          limitation="Checked body includes the full rear and is wider than the chassis at the rear, but the wheel's front tip extends0.01m farther.")

    # Velocity reconstruction and rollout are tested against a scalar integrator
    # using generic robot acceleration limits, not a mover trajectory.
    ns = space()
    v0, w0, dt = .3, .2, LIMITS["step_s"]
    yaw0 = math.pi-.001
    ns["_BASE_POSES"][:] = [(10.-dt, -v0*math.cos(yaw0)*dt, -v0*math.sin(yaw0)*dt, yaw0-w0*dt), (10., 0., 0., yaw0)]
    reconstructed = observed_velocity(ns)
    check("pose_history_recovers_signed_current_velocity", np.allclose(reconstructed, (v0, w0), atol=1e-12), estimated=reconstructed)
    metadata = apply_patch(ns, "accel")
    times = np.arange(181)*dt
    arrays = ns["_m1_accel_rollout"](-.2, -.4, times)
    actual, v, w = [(0., 0., yaw0)], v0, w0
    for _ in range(180):
        v += max(-2.*dt, min(2.*dt, -.2-v)); w += max(-2.68*dt, min(2.68*dt, -.4-w))
        x, y, yaw = actual[-1]; yaw += w*dt
        actual.append((x+v*math.cos(yaw)*dt, y+v*math.sin(yaw)*dt, yaw))
    error = float(np.max(np.abs(np.column_stack(arrays)-np.asarray(actual))))
    check("acceleration_rollout_matches_scalar_physics", error < 1e-12, max_error=error)
    # A stop command has nonzero travel when the pose history says the robot is moving.
    old, new = space(), space()
    for state in (old, new): state["_BASE_POSES"][:] = [(10.-dt, -dt, 0., 0.), (10., 0., 0., 0.)]
    apply_patch(new, "accel")
    before, after = old["check_motion"](0., 0., 1.), new["check_motion"](0., 0., 1.)
    check("stop_inertia_present_only_in_accel_variant", before["end_pose"][0] == 0. and .24 < after["end_pose"][0] < .25,
          instant_command_end=before["end_pose"], acceleration_end=after["end_pose"])
    # The new rollover must preserve zero-horizon and all untouched policy functions.
    ns_old, ns_new = space([object_fixture(2., 0., -.3, .1)]), space([object_fixture(2., 0., -.3, .1)])
    keys = ("_base_command_candidates", "_base_choose_rank", "observed_objects", "_base_map_horizon", "check_path")
    preserved = {k: ns_new[k] for k in keys}
    apply_patch(ns_new, "accel")
    check("zero_horizon_geometry_exactly_preserved", ns_new["check_motion"](.3, .4, 0.) == ns_old["check_motion"](.3, .4, 0.))
    check("ranking_candidates_tracker_and_horizon_policy_unchanged", all(ns_new[k] is preserved[k] for k in keys))
    baseline = space([object_fixture(2., 0., -.3, .1)])
    original = baseline["choose_command"](.3, 0., (5., 0.))
    apply_patch(baseline, "baseline")
    check("baseline_patch_is_noop", baseline["choose_command"](.3, 0., (5., 0.)) == original)
    check("operational_base_file_unchanged", hashlib.sha256(BASE.read_bytes()).hexdigest() == unchanged_sha)
    # Candidate-only ablation leaves the same point predictor and rank function.
    ns = space()
    original_rank, original_core = ns["_base_choose_rank"], ns["_base_check_motion"]
    curve_meta = apply_patch(ns, "curves")
    factory = ns["_base_command_candidates"]
    contains_curves = all({(.3, .4), (.3, -.4)} <= {(v, w) for _, v, w in factory(vf, .1, (5., 2.))}
                          for vf in (0., .3, -.2))
    check("curves_add_only_two_generic_commands_preserving_rank_and_predictor", contains_curves
          and ns["_base_choose_rank"] is original_rank and ns["_base_check_motion"] is original_core,
          patch=curve_meta)
    with_duplicate = factory(.3, .4, (5., 2.))
    check("curves_do_not_duplicate_existing_commands", sum((v,w) == (.3,.4) for _,v,w in with_duplicate) == 1)
    before = ns["choose_command"](.3, .1, (5., 2.))
    ns["_base_command_candidates"] = lambda *a: list(reversed(factory(*a)))
    after = ns["choose_command"](.3, .1, (5., 2.))
    check("curves_selection_is_order_invariant", before == after)
    performance = {}
    from b515_check_offline import load_ns
    for variant in ("baseline", "accel", "curves"):
        bench = load_ns(BASE)
        objects = [object_fixture(-6.+i*.25, -10.+i*.15, -.1+i*.02, .05, ident=i) for i in range(10)]
        seed(bench, objects, pose=(-8., -10., 0.), now=10.)
        bench["_BASE_POSES"].insert(0, (10.-1./60., -8.-.3/60., -10., 0.))
        apply_patch(bench, variant)
        for vf in (.3, 0.):
            for _ in range(30): bench["choose_command"](vf, .2, (-5., -7.))
            measured = []
            for sample in range(200):
                # A fresh observed pose/time invalidates trajectory caching each tick.
                # Sensor/pose preparation is excluded from the chooser timing.
                now = 20. + sample/60.
                x = -8. + sample*.3/60.
                bench["_BASE_POSES"][:] = [(now-1./60., x-.3/60., -10., 0.), (now, x, -10., 0.)]
                for track in bench["_BASE_OBJ_ST"]["tracks"]:
                    _, ox, oy = track["hist"][-1]
                    track["hist"][-1] = (now, ox, oy)
                start = time.perf_counter_ns(); bench["choose_command"](vf, .2, (-5., -7.))
                measured.append((time.perf_counter_ns()-start)/1e6)
            label = variant + ("_following" if vf else "_alignment")
            performance[label] = {"median_ms": float(np.median(measured)), "p95_ms": float(np.percentile(measured,95)),
                                  "calls": 200, "objects": 10, "points_each": 20,
                                  "candidates": len(bench["_base_command_candidates"](vf, .2, (-5., -7.))),
                                  "measurement": "actual choose_command boundary with fresh pose/time each call; excludes sensor setup and trace/log recording"}
    evidence["patch"] = metadata
    evidence["performance"] = performance
    passed = sum(c["pass"] for c in checks.values())
    report = {"verdict": "pass" if passed == len(checks) else "fail", "passed": passed, "total": len(checks),
              "base_sha16": unchanged_sha[:16], "checks": checks, "evidence": evidence,
              "limitations": ["Fixtures establish that existing rear geometry, observation age and uncertainty are implemented; they do not establish accurate hidden object geometry or future velocity.",
                              "Acceleration and curves variants are analysis-only ablations, not adopted fixes or successful collision regressions.",
                              "Current velocity uses one pose interval; real pose noise and actuator/slip behavior can differ.",
                              "Starting with fewer than two poses assumeszero current speed.",
                              "The uncertainty model and all-unsafe fallback remain unchanged; no safe candidate means the selector may still return a predicted unsafe command."]}
    archive_before_write(OUT)
    OUT.write_text(json.dumps(safe_json(report), ensure_ascii=False, indent=2, allow_nan=False)+"\n")
    print(f"{report['verdict']} {passed}/{len(checks)} {OUT}")
    for name, c in checks.items():
        if not c["pass"]: print("FAIL", name, c)
    return report


if __name__ == "__main__":
    raise SystemExit(0 if selftest()["verdict"] == "pass" else 1)
