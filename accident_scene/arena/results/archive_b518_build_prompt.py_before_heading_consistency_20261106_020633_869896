def archive_write(path, text):
    if path.exists():
        if path.read_text() == text:
            return
        shutil.copy2(path, ARENA / "results" / f"archive_{path.name}_before_b518_{datetime.now():%Y%m%d_%H%M%S_%f}")
    path.write_text(text)


