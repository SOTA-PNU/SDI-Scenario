def sha(text):
    return hashlib.sha256(text.encode()).hexdigest()


def rel(path):
    return str(path.relative_to(ARENA))


def ref(path, number):
    return {"file": rel(path), "line": number, "text": path.read_text().splitlines()[number - 1]}


def matching(path, needle):
    return [ref(path, i) for i, line in enumerate(path.read_text().splitlines(), 1) if needle in line]


def command_audit(path):
    source = path.read_text()
    controller = next(n for n in ast.parse(source).body if isinstance(n, ast.FunctionDef) and n.name == "controller")
    writes, returns, calls = [], [], []
    for n in ast.walk(controller):
        if isinstance(n, ast.Assign):
            targets = {k.id for target in n.targets for k in ast.walk(target) if isinstance(k, ast.Name)}
            if targets & {"v", "w"}:
                is_choose = isinstance(n.value, ast.Call) and isinstance(n.value.func, ast.Name) and n.value.func.id == "choose_command"
                writes.append({**ref(path, n.lineno), "both_v_w_written": {"v", "w"} <= targets, "rhs_is_choose_command": is_choose})
        if isinstance(n, (ast.AnnAssign, ast.AugAssign)):
            assert not any(isinstance(k, ast.Name) and k.id in ("v", "w") for k in ast.walk(n.target))
        if isinstance(n, ast.Return):
            values = n.value.elts if isinstance(n.value, ast.Tuple) else []
            returns.append({**ref(path, n.lineno), "returns_v_w": len(values) == 3 and [ast.dump(v) for v in values[:2]] == [ast.dump(ast.Name(id=x, ctx=ast.Load())) for x in ("v", "w")]})
        if isinstance(n, ast.Call) and isinstance(n.func, ast.Name) and n.func.id == "choose_command":
            calls.append({**ref(path, n.lineno), "v_follow": ast.unparse(n.args[0]), "w_follow": ast.unparse(n.args[1]), "target_xy": ast.unparse(n.args[2]), "horizon_explicit": len(n.args) > 3 or bool(n.keywords)})
    assert writes and returns and all(x["both_v_w_written"] and x["rhs_is_choose_command"] for x in writes) and all(x["returns_v_w"] for x in returns)
    return {"method": "AST over controller only: every write to returned v/w is a joint choose_command assignment; every return is v,w,done. No AugAssign/AnnAssign write to v/w.", "all_motion_returns_are_chooser_outputs": True, "velocity_writes": sorted(writes, key=lambda x: x["line"]), "returns": sorted(returns, key=lambda x: x["line"]), "calls": sorted(calls, key=lambda x: x["line"])}


def debug_rows(path):
    result = []
    for number, line in enumerate(path.read_text().splitlines(), 1):
        if "DBG choose " in line:
            fields = dict(re.findall(r"(\w+)=([^ ]+)", line[line.index("DBG choose "):]))
            parsed = {}
            for key, value in fields.items():
                parsed[key] = value if key in ("pick", "why") else None if value == "-" else value if value in ("inf", "-inf") else float(value)
            result.append({**ref(path, number), **parsed})
    return result


