def plan_stage(stage, input_points=None, output_points=None):
    """Record the model's last planning stage, never generate or change a path.

    Use only inside plan_path; stage is grid/search/simplify/validate. Optional
    counts are nonnegative integers. Each attempt clears its previous marker;
    the base captures a copy in plan_attempts/plan_summary and rejected-plan DBG.
    Counts are model-reported diagnostics, not proof that a stage was correct.
    """
    if _BASE_LOOP_ST["plan_context"] is None:
        raise RuntimeError("plan_stage is only available during plan_path")
    if stage not in ("grid", "search", "simplify", "validate"):
        raise ValueError("plan_stage requires grid/search/simplify/validate")
    counts = []
    for count in (input_points, output_points):
        if count is None:
            counts.append(None)
            continue
        if isinstance(count, (bool, np.bool_)) or not isinstance(count, (int, np.integer)) or count < 0:
            raise ValueError("plan_stage counts must be nonnegative integers or None")
        counts.append(int(count))
    marker = {"stage": stage, "input_points": counts[0], "output_points": counts[1]}
    _BASE_LOOP_ST["plan_stage"] = marker
    return dict(marker)


